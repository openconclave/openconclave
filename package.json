{
  "name": "openconclave",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --filter server dev",
    "dev:client": "bun run --filter client dev",
    "start": "bun run start.ts",
    "build": "bun run --filter '*' build",
    "build:release": "bun run scripts/build-release.ts",
    "build:release:all": "bun run scripts/build-release.ts --all",
    "test": "bun test packages/shared packages/server",
    "test:server": "bun test packages/server",
    "test:shared": "bun test packages/shared",
    "test:client": "bun run --filter client test"
  },
  "devDependencies": {},
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.111",
    "@dagrejs/dagre": "^3.0.0"
  },
  "patchedDependencies": {
    "@anthropic-ai/claude-agent-sdk@0.2.111": "patches/@anthropic-ai%2Fclaude-agent-sdk@0.2.111.patch"
  }
}
